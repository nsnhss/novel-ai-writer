# Tauri updater signing key (REQUIRED for auto-update)
# Use the raw private key string. Generate your keypair with:
#   npm run tauri -- signer generate --password <STRONG_PASSWORD> --write-keys .tauri
# Then paste the contents of .tauri here.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows installer code signing (optional, for SmartScreen / trusted publisher)
# Base64-encoded PFX/P12 certificate content
WINDOWS_CERTIFICATE=
WINDOWS_CERTIFICATE_PASSWORD=

# macOS code signing & notarization (optional, for Gatekeeper / trusted app)
# Base64-encoded .p12 certificate exported from Keychain Access
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
# Common name of the "Developer ID Application" certificate in your keychain
APPLE_SIGNING_IDENTITY=
# App Store Connect Apple ID + app-specific password + team ID
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Linux AppImage GPG signing (optional)
APPIMAGE_SIGN_PASSPHRASE=
